<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <!-- 页面底色画在这里，与窗口背景（android:colorBackground）同色，肉眼无差别：
         以后玻璃捕获下层内容时取到的是不透明的页面底色，而不是窗口背景那块透明 -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/fragment_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground" />

    <!-- We double trackThickness as half of it will be invisible -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/fabProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:max="1"
        android:visibility="invisible"
        app:indicatorColor="?attr/colorPrimary"
        app:layout_anchor="@+id/fab"
        app:layout_anchorGravity="center"
        app:layout_behavior="io.nekohasekai.sagernet.widget.FabProgressBehavior"
        app:trackCornerRadius="@dimen/mtrl_progress_track_thickness"
        app:trackThickness="8dp" />

    <!-- 连接按钮：M3 FAB（Primary）样式，56dp，用 50% 圆角的 overlay 保持圆形；静止阴影取样式的 6dp，
         按下不抬升（样式的 translationZ 为 0）。固定在右下角，与 Dock 垂直居中（底边距 2 + (64 − 56) / 2）。
         外边距在 MainActivity 里再加上系统栏与刘海的插入区 -->
    <io.nekohasekai.sagernet.widget.ServiceButton
        android:id="@+id/fab"
        style="@style/Widget.Material3.FloatingActionButton.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="@dimen/fab_margin_bottom"
        android:nextFocusDown="@+id/stats"
        app:backgroundTint="?fabColorBackground"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.SagerNet.Circle"
        app:srcCompat="@drawable/ic_service_idle"
        app:tint="?attr/colorOnPrimaryContainer" />

    <!-- 状态卡片：悬浮在 Dock 上方 8dp（底边距 2 + 64 + 8），只在已连接时出现。
         形状 Extra large（28dp）、阴影 3dp（level 2）。android:theme 把滑入 / 滑出的时长重映射成
         300 / 250ms，见 ThemeOverlay.SagerNet.StatsBarMotion。
         内容两行：速率行（上行 / 下行并排）+ 状态行（状态点 + 一段状态文字），高约 84dp -->
    <io.nekohasekai.sagernet.widget.StatsBar
        android:id="@+id/stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="@dimen/nav_dock_clearance"
        android:nextFocusUp="@+id/fab"
        android:theme="@style/ThemeOverlay.SagerNet.StatsBarMotion"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardElevation="@dimen/stats_bar_elevation"
        app:shapeAppearance="?attr/shapeAppearanceCornerExtraLarge"
        app:strokeWidth="0dp">

        <LinearLayout
            android:id="@+id/stats_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- tx：整列是一个无障碍节点（contentDescription 由 StatsBar 与可见文字同步），子视图不单独朗读 -->
                <LinearLayout
                    android:id="@+id/tx_column"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:importantForAccessibility="yes"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tx_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="14dp"
                        android:importantForAccessibility="no"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- 数字：等宽数字（tnum）、右对齐，最小宽度由 StatsBar 按字体实测（容得下 3 位数字加小数点） -->
                    <TextView
                        android:id="@+id/tx_number"
                        android:importantForAccessibility="no"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tx_unit"
                        android:importantForAccessibility="no"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <!-- rx：整列是一个无障碍节点（contentDescription 由 StatsBar 与可见文字同步），子视图不单独朗读 -->
                <LinearLayout
                    android:id="@+id/rx_column"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:importantForAccessibility="yes"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/rx_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="14dp"
                        android:importantForAccessibility="no"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- 数字：等宽数字（tnum）、右对齐，最小宽度由 StatsBar 按字体实测（容得下 3 位数字加小数点） -->
                    <TextView
                        android:id="@+id/rx_number"
                        android:importantForAccessibility="no"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/rx_unit"
                        android:importantForAccessibility="no"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 状态点：8dp，颜色与实心 / 空心由 StatsBar 按状态设置（只取主题角色） -->
                <View
                    android:id="@+id/status_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="@string/connection_test_available" />
            </LinearLayout>

        </LinearLayout>

    </io.nekohasekai.sagernet.widget.StatsBar>

    <!-- 底部悬浮 Dock：四个一级页面入口，右侧让出连接按钮。外边距在 MainActivity 里再加上
         系统栏与刘海的插入区 -->
    <io.nekohasekai.sagernet.widget.NavDock
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_dock_height"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="@dimen/nav_dock_margin_end"
        android:layout_marginBottom="@dimen/nav_dock_margin_bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
