<?xml version="1.0" encoding="utf-8"?>
<!-- 所有没有自定义 dialogLayout 的 EditTextPreference 共用的对话框（OutlinedEditTextDialogFragment）：说明文字
     （dialogMessage，没有就隐藏）加 Outlined 文本框，左右与其它代码里建的输入对话框（layout_dialog_input）对齐。
     @android:id/message、@android:id/edit 是 androidx.preference 要求的 id。文本框不设 singleLine，与 androidx 默认的
     对话框一样允许多行（有的项按行填列表），输入类型只由 setOnBindEditTextListener 的修饰决定。
     错误行有校验规则时才由代码启用（errorEnabled），没规则的项下面不留空行 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@android:id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@android:id/edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
