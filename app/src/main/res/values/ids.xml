<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 主界面各页面的 id：一级页面对应 Dock 的四项，其余是从设置一级页进入的二级页面
         （设置的七个分类页不占 id，由 SettingsFragment.section 打开）。
         MainActivity.displayFragmentWithId 按它们分发 -->
    <item name="nav_configuration" type="id" />
    <item name="nav_group" type="id" />
    <item name="nav_route" type="id" />
    <item name="nav_settings" type="id" />
    <item name="nav_logcat" type="id" />
    <item name="nav_traffic" type="id" />
    <item name="nav_tools" type="id" />
    <item name="nav_about" type="id" />

    <!-- setPlaceholderVisible 记录占位视图当前的目标显隐（淡出期间视图仍是 VISIBLE） -->
    <item name="placeholder_target" type="id" />

    <!-- NavDock 图标脉冲动画挂在图标容器上的 tag，换选中项时取出来取消 -->
    <item name="nav_dock_pulse" type="id" />

    <!-- ScrollHub 挂在滚动视图上的 tag：每个滚动视图唯一的滚动分发器 -->
    <item name="scroll_hub" type="id" />

    <!-- padForSystemBars 挂在视图上的重算函数（按最近一次的插入区重新算内边距），见 reapplySystemBarPadding -->
    <item name="system_bar_padding" type="id" />
</resources>
