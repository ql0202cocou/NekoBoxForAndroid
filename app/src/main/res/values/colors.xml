<?xml version="1.0" encoding="utf-8"?>
<resources>

    <color name="material_blue_500">#2196F3</color>
    <color name="material_green_500">#4CAF50</color>
    <color name="material_orange_500">#FF9800</color>

    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <color name="color_pink_ssr">#fb7299</color>

    <!-- 语义色，亮暗各一套（暗色见 values-night/colors.xml），取值来自 Material 2014 色板。
         测速可用 / 不可用：原来的 green 500 / red 500 在亮色 surface 上只有 2.65:1 / 3.51:1，
         亮色改用 green 800 / red 700（4.89:1 / 4.75:1，过 4.5:1） -->
    <color name="status_ok">#2E7D32</color>
    <color name="status_error">#D32F2F</color>
    <!-- 同一语义落在更深的底上时用深一档：测速对话框（surfaceContainerHigh）与选中的节点卡片。
         亮色 green 800 / red 700 在那里只有约 4.1:1，改用 green 900 / red 900（六套主题最低 6.25:1 / 5.22:1） -->
    <color name="status_ok_strong">#1B5E20</color>
    <color name="status_error_strong">#B71C1C</color>
    <!-- 日志页三色：原来亮暗共用 #86C166 / #FF0000 / #888888，在亮色底上对比不足，
         亮色改用 green 700 / red 700 / grey 600 -->
    <color name="log_info">#388E3C</color>
    <color name="log_error">#D32F2F</color>
    <color name="log_other">#757575</color>

</resources>
