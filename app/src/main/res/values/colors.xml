<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 选色网格的种子色（Material 2014 色板的 500 色；红、青用 700 色，原因见 M3Palette.specs），与 M3Palette.specs 一致 -->
    <color name="material_red_700">#D32F2F</color>
    <color name="material_orange_500">#FF9800</color>
    <color name="material_amber_500">#FFC107</color>
    <color name="material_green_500">#4CAF50</color>
    <color name="material_teal_700">#00796B</color>
    <color name="material_blue_500">#2196F3</color>
    <color name="material_indigo_500">#3F51B5</color>
    <color name="material_purple_500">#9C27B0</color>
    <color name="material_brown_500">#795548</color>

    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <color name="color_pink_ssr">#fb7299</color>

    <!-- 语义色，亮暗各一套（暗色见 values-night/colors.xml），取值来自 Material 2014 色板；
         显示前经 ui/StatusColors 向主题色和谐化（白 / 黑主题除外）。
         测速：可用（不超过 600 ms）green 500、慢 orange 500、不可用 red 500 -->
    <color name="status_ok">#4CAF50</color>
    <color name="status_slow">#FF9800</color>
    <color name="status_error">#F44336</color>
    <!-- 日志页：信息 green 700、警告 orange 700（亮色底上对比够）；错误用主题的 error 角色、
         其它行用 outline 角色，不再写字面色 -->
    <color name="log_info">#388E3C</color>
    <color name="log_warn">#F57C00</color>

</resources>
