<resources>
    <dimen name="qrcode_size">264dp</dimen>
    <!-- 主界面底部悬浮 Dock：高 64dp，全圆角，内边距 4dp，项高 56dp；底边在导航栏上方 2dp；
         右侧让出连接按钮：12（右边距）+ 56（按钮）+ 8（间隙） -->
    <dimen name="nav_dock_height">64dp</dimen>
    <dimen name="nav_dock_radius">32dp</dimen>
    <dimen name="nav_dock_padding">4dp</dimen>
    <dimen name="nav_dock_elevation">3dp</dimen>
    <dimen name="nav_dock_item_radius">28dp</dimen>
    <dimen name="nav_dock_margin_bottom">2dp</dimen>
    <dimen name="nav_dock_margin_end">76dp</dimen>
    <!-- Dock 顶边再往上 8dp：状态卡片的底边距，也是主界面列表在导航栏之上要让出的高度
         （2 + 64 + 8）；状态卡片出现时列表再让出卡片高度 + 8dp -->
    <dimen name="nav_dock_clearance">74dp</dimen>
    <dimen name="stats_bar_gap">8dp</dimen>
    <!-- 连接按钮（56dp）与 Dock 垂直居中：2 + (64 − 56) / 2 -->
    <dimen name="fab_margin_bottom">6dp</dimen>
    <!-- 对话框窗口背景（drawable/alert_dialog_background）：取值同 material 的
         mtrl_alert_dialog_background_inset_*（高度不足 480dp 时四边 10dp，见 values-h480dp）与
         m3_alert_dialog_corner_size -->
    <dimen name="alert_dialog_inset_horizontal">10dp</dimen>
    <dimen name="alert_dialog_inset_vertical">10dp</dimen>
    <dimen name="alert_dialog_corner_radius">28dp</dimen>
</resources>
