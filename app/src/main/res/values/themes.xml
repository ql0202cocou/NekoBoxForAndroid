<resources>
    <!-- 应用基础主题 -->
    <style name="Theme.SagerNet" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/material_pink_500</item>
        <item name="colorPrimaryDark">@color/material_pink_700</item>
        <!-- M3 主题默认 colorAccent = ?colorSecondary，开关、设置分类标题、备份页按钮都按它着色；
             这里和每个颜色变体都显式给值，所以不会落到 secondary -->
        <item name="colorAccent">@color/material_pink_accent_200</item>

        <item name="colorMaterial100">@color/material_pink_100</item>
        <item name="colorMaterial300">@color/material_pink_300</item>

        <item name="accentOrTextSecondary">?colorAccent</item>
        <item name="accentOrTextPrimary">?colorAccent</item>
        <item name="primaryOrTextSecondary">?colorPrimary</item>
        <item name="primaryOrTextPrimary">?colorPrimary</item>

        <item name="fabColorBackground">?colorPrimary</item>
        <item name="selectedColorPrimary">?colorPrimary</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="tabTextColor">#99FFFFFF</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabIndicatorColor">@color/white</item>
        <item name="tabRippleColor">@color/white</item>
        <item name="whiteOrTextPrimary">@color/white</item>

        <!-- 去掉 ActionBar，但保留它的样式与主题 -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="chipStyle">@style/Widget.SagerNet.Chip.Choice</item>

        <item name="itemShapeAppearance">
            @style/ShapeAppearance.Material3.Corner.Medium
        </item>

        <item name="alertDialogTheme">
            @style/ThemeOverlay.SagerNet.MaterialAlertDialog
        </item>

        <item name="materialAlertDialogTheme">
            @style/ThemeOverlay.SagerNet.MaterialAlertDialog
        </item>

        <!-- M3 默认底栏把 FAB 挪到右端并嵌进底栏（end + embed），和底栏同色看不见；
             Legacy 保留 M2 的居中凹槽（center + cradle） -->
        <item name="bottomAppBarStyle">@style/Widget.Material3.BottomAppBar.Legacy</item>

    </style>

    <style name="Theme.SagerNet.Dialog" parent="Theme.Material3.DayNight.Dialog.Alert">
        <!-- M3 下 ?colorPrimaryDark 就是 primary，导航栏不再跟它走，免得在可见时成一条主题色带 -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/material_pink_500</item>
        <item name="colorPrimaryDark">@color/material_pink_700</item>
        <!-- M3 主题默认 colorAccent = ?colorSecondary；这里和每个颜色变体都显式给值 -->
        <item name="colorAccent">@color/material_pink_accent_200</item>

        <item name="colorMaterial100">@color/material_pink_100</item>
        <item name="colorMaterial300">@color/material_pink_300</item>

        <item name="accentOrTextSecondary">?colorAccent</item>
        <item name="accentOrTextPrimary">?colorAccent</item>
        <item name="primaryOrTextSecondary">?colorPrimary</item>
        <item name="primaryOrTextPrimary">?colorPrimary</item>

        <item name="fabColorBackground">?colorPrimary</item>
        <item name="selectedColorPrimary">?colorPrimary</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="tabTextColor">#99FFFFFF</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabIndicatorColor">@color/white</item>
        <item name="tabRippleColor">@color/white</item>
        <item name="whiteOrTextPrimary">@color/white</item>

        <!-- 去掉 ActionBar，但保留它的样式与主题 -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="chipStyle">@style/Widget.SagerNet.Chip.Choice</item>

        <item name="itemShapeAppearance">
            @style/ShapeAppearance.Material3.Corner.Medium
        </item>

        <item name="alertDialogTheme">
            @style/ThemeOverlay.SagerNet.MaterialAlertDialog
        </item>

        <item name="materialAlertDialogTheme">
            @style/ThemeOverlay.SagerNet.MaterialAlertDialog
        </item>

        <item name="windowFixedHeightMajor" type="dimen">95%</item>

    </style>

    <style name="AppearanceFoundation.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ThemeOverlay.SagerNet.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">
            @style/Widget.SagerNet.Button.TextButton.Dialog
        </item>
        <item name="buttonBarNegativeButtonStyle">
