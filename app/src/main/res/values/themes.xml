<resources>
    <!-- 应用基础主题 -->
    <style name="Theme.SagerNet" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 颜色角色由各主题的样式提供（themes_m3.xml，生成）。
             M3 主题默认 colorAccent = ?colorSecondary，开关、设置分类标题、AppCompat 的 Colored 按钮
             都按它着色，这里改回 primary -->
        <item name="colorAccent">?attr/colorPrimary</item>

        <!-- 自定义颜色属性都指向 M3 角色，随所选主题与日夜切换 -->
        <item name="accentOrTextSecondary">?attr/colorPrimary</item>
        <item name="primaryOrTextSecondary">?attr/colorPrimary</item>
        <item name="primaryOrTextPrimary">?attr/colorPrimary</item>
        <item name="fabColorBackground">?attr/colorPrimaryContainer</item>
        <item name="selectedColorPrimary">?attr/colorPrimary</item>
        <!-- 顶部栏按 M3：surface 底，标题与图标 onSurface，主题色只做点缀；
             Tab 用 Widget.Material3.TabLayout 的默认文字色与 primary 指示条 -->
        <item name="appBarColor">?attr/colorSurface</item>
        <item name="actionBarTheme">@style/ThemeOverlay.Material3.Toolbar.Surface</item>
        <!-- 文字与控件默认色走主题角色（res/color/theme_text_*）：M3 主题把它们指向固定的基线中性色，
             不随六套主题变；这里改成 onSurface / onSurfaceVariant 的状态列表，禁用态 alpha 照 M3 -->
        <item name="android:textColorPrimary">@color/theme_text_primary</item>
        <item name="android:textColorSecondary">@color/theme_text_secondary</item>
        <item name="android:textColorTertiary">@color/theme_text_secondary</item>
        <item name="android:textColorHint">@color/theme_text_hint</item>
        <item name="android:textColorPrimaryDisableOnly">@color/theme_text_primary_disable_only</item>
        <item name="android:textColorAlertDialogListItem">@color/theme_text_primary</item>
        <item name="colorControlNormal">@color/theme_text_secondary</item>
        <!-- 设置页的开关用 M3 MaterialSwitch（见 PreferenceThemeOverlay.SagerNet） -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.SagerNet</item>

        <!-- 去掉 ActionBar，但保留它的样式与主题 -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="chipStyle">@style/Widget.SagerNet.Chip.Choice</item>

        <item name="alertDialogTheme">
            @style/ThemeOverlay.SagerNet.MaterialAlertDialog
        </item>

        <item name="materialAlertDialogTheme">
            @style/ThemeOverlay.SagerNet.MaterialAlertDialog
        </item>

    </style>

    <style name="Theme.SagerNet.Dialog" parent="Theme.Material3.DayNight.Dialog.Alert">
        <!-- M3 下 ?colorPrimaryDark 就是 primary，导航栏不再跟它走，免得在可见时成一条主题色带 -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- 颜色角色由各主题的样式提供（themes_m3.xml，生成）。
             M3 主题默认 colorAccent = ?colorSecondary，开关、设置分类标题、AppCompat 的 Colored 按钮
             都按它着色，这里改回 primary -->
        <item name="colorAccent">?attr/colorPrimary</item>

        <!-- 自定义颜色属性都指向 M3 角色，随所选主题与日夜切换 -->
        <item name="accentOrTextSecondary">?attr/colorPrimary</item>
        <item name="primaryOrTextSecondary">?attr/colorPrimary</item>
        <item name="primaryOrTextPrimary">?attr/colorPrimary</item>
        <item name="fabColorBackground">?attr/colorPrimaryContainer</item>
        <item name="selectedColorPrimary">?attr/colorPrimary</item>
        <!-- 顶部栏按 M3：surface 底，标题与图标 onSurface，主题色只做点缀；
             Tab 用 Widget.Material3.TabLayout 的默认文字色与 primary 指示条 -->
        <item name="appBarColor">?attr/colorSurface</item>
        <item name="actionBarTheme">@style/ThemeOverlay.Material3.Toolbar.Surface</item>
        <!-- 文字与控件默认色走主题角色（res/color/theme_text_*）：M3 主题把它们指向固定的基线中性色，
             不随六套主题变；这里改成 onSurface / onSurfaceVariant 的状态列表，禁用态 alpha 照 M3 -->
        <item name="android:textColorPrimary">@color/theme_text_primary</item>
        <item name="android:textColorSecondary">@color/theme_text_secondary</item>
        <item name="android:textColorTertiary">@color/theme_text_secondary</item>
        <item name="android:textColorHint">@color/theme_text_hint</item>
        <item name="android:textColorPrimaryDisableOnly">@color/theme_text_primary_disable_only</item>
        <item name="android:textColorAlertDialogListItem">@color/theme_text_primary</item>
        <item name="colorControlNormal">@color/theme_text_secondary</item>
        <!-- 设置页的开关用 M3 MaterialSwitch（见 PreferenceThemeOverlay.SagerNet） -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.SagerNet</item>

        <!-- 去掉 ActionBar，但保留它的样式与主题 -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="chipStyle">@style/Widget.SagerNet.Chip.Choice</item>

        <item name="alertDialogTheme">
            @style/ThemeOverlay.SagerNet.MaterialAlertDialog
        </item>

        <item name="materialAlertDialogTheme">
            @style/ThemeOverlay.SagerNet.MaterialAlertDialog
        </item>

        <item name="windowFixedHeightMajor" type="dimen">95%</item>

    </style>

    <!-- 设置页主题：在 androidx 默认的 PreferenceThemeOverlay 上只换 SwitchPreferenceCompat 的开关控件 -->
    <style name="PreferenceThemeOverlay.SagerNet" parent="PreferenceThemeOverlay">
        <item name="switchPreferenceCompatStyle">@style/Preference.SwitchPreferenceCompat.SagerNet</item>
    </style>

    <style name="Preference.SwitchPreferenceCompat.SagerNet" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:widgetLayout">@layout/preference_widget_material_switch</item>
    </style>

    <style name="AppearanceFoundation.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ThemeOverlay.SagerNet.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!-- alertDialogTheme 也指向这里：AppCompat AlertDialog.Builder 建的对话框不经 MaterialAlertDialogBuilder 设背景，
             父链里的窗口背景是 2dp 圆角、colorBackgroundFloating（亮 #FFFFFF / 暗 #424242）。换成与
             MaterialAlertDialogBuilder 相同的外观；后者在代码里另设背景，不受影响 -->
        <item name="android:windowBackground">@drawable/alert_dialog_background</item>
        <item name="android:colorBackground">?attr/colorSurfaceContainerHigh</item>
        <item name="buttonBarPositiveButtonStyle">
            @style/Widget.SagerNet.Button.TextButton.Dialog
        </item>
        <item name="buttonBarNegativeButtonStyle">
            @style/Widget.SagerNet.Button.TextButton.Dialog
        </item>
        <item name="buttonBarNeutralButtonStyle">
            @style/Widget.SagerNet.Button.TextButton.Dialog.Flush
        </item>
    </style>

    <style name="Widget.SagerNet.Button.TextButton.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">?primaryOrTextPrimary</item>
    </style>

    <style name="Widget.SagerNet.Button.TextButton.Dialog.Flush" parent="Widget.Material3.Button.TextButton.Dialog.Flush">
        <item name="android:textColor">?primaryOrTextPrimary</item>
    </style>

    <!-- M3 的默认 chipStyle 是不可勾选的 Assist，这里从 Filter 派生并隐藏勾选图标，保持单选 Chip 的外观；
         文字两侧内边距 12dp：没有勾选图标，左右对称，一行放得下分应用代理页的几个 Chip -->
    <style name="Widget.SagerNet.Chip.Choice" parent="Widget.Material3.Chip.Filter">
        <item name="checkedIconVisible">false</item>
        <item name="textStartPadding">12dp</item>
        <item name="textEndPadding">12dp</item>
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="checkedIconTint">?primaryOrTextPrimary</item>
        <item name="rippleColor">@color/chip_ripple_color</item>
    </style>

    <style name="Theme.Start" parent="Theme.Material3.DayNight">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@android:color/transparent</item>
        <item name="colorPrimaryDark">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

</resources>