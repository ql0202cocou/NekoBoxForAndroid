<?xml version="1.0" encoding="utf-8"?>
<full-backup-content xmlns:tools="http://schemas.android.com/tools"
                     tools:ignore="FullBackupContent">
    <!-- Android 7–8.1：requireFlags 要 API 28 才认，无法区分云备份与换机迁移，只能
         全部不备份（不上传的理由见 backup_rules.xml）。只写 exclude 时其余内容默认照备，
         所以显式排除所有域。9–11 见 xml-v28/backup_descriptor.xml -->
    <exclude
        domain="root"
        path="." />
    <exclude
        domain="device_root"
        path="." />
    <exclude
        domain="external"
        path="." />
</full-backup-content>
