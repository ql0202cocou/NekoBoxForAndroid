{
  "dns": {
    "final": "dns-remote",
    "rules": [
      {
        "domain": [
          "hy2.example.com",
          "trojan.example.com",
          "vless.example.com",
          "vmess.example.com",
          "anytls.example.com",
          "dns.example.net"
        ],
        "server": "dns-direct",
        "strategy": "ipv4_only"
      },
      {
        "disable_cache": true,
        "inbound": [
          "tun-in"
        ],
        "server": "dns-fake",
        "strategy": "ipv4_only"
      }
    ],
    "servers": [
      {
        "detour": "direct",
        "tag": "dns-local",
        "type": "local"
      },
      {
        "domain_resolver": "dns-local",
        "path": "/dns-query",
        "server": "192.0.2.53",
        "tag": "dns-direct",
        "type": "https"
      },
      {
        "detour": "proxy",
        "domain_resolver": "dns-direct",
        "path": "/dns-query",
        "server": "dns.example.net",
        "tag": "dns-remote",
        "type": "https"
      },
      {
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18",
        "tag": "dns-fake",
        "type": "fakeip"
      }
    ],
    "strategy": "ipv4_only"
  },
  "endpoints": [],
  "inbounds": [
    {
      "address": [
        "172.19.0.1/28"
      ],
      "endpoint_independent_nat": true,
      "mtu": 9000,
      "stack": "gvisor",
      "tag": "tun-in",
      "type": "tun"
    },
    {
      "listen": "127.0.0.1",
      "listen_port": 2080,
      "tag": "mixed-in",
      "type": "mixed"
    },
    {
      "listen": "127.0.0.1",
      "listen_port": 35967,
      "override_address": "vless.example.com",
      "override_port": 443,
      "tag": "c-2-mapping-2",
      "type": "direct"
    },
    {
      "listen": "127.0.0.1",
      "listen_port": 39387,
      "override_address": "anytls.example.com",
      "override_port": 8443,
      "tag": "c-3-mapping-3",
      "type": "direct"
    }
  ],
  "log": {
    "level": "panic"
  },
  "outbounds": [
    {
      "default": "golden-sel-vmess",
      "outbounds": [
        "golden-sel-vmess",
        "golden-sel-xray",
        "golden-sel-anytls",
        "golden-sel-trojan",
        "golden-sel-hy2"
      ],
      "tag": "proxy",
      "type": "selector"
    },
    {
      "alter_id": 0,
      "packet_encoding": "",
      "security": "auto",
      "server": "vmess.example.com",
      "server_port": 443,
      "tls": {
        "enabled": true,
        "insecure": false,
        "server_name": "cdn.example.org"
      },
      "transport": {
        "headers": {
          "Host": "cdn.example.org"
        },
        "path": "/golden-ws",
        "type": "ws"
      },
      "uuid": "5a0c1e2f-3b4d-4e6f-8a9b-0c1d2e3f4a5b",
      "tag": "golden-sel-vmess",
      "type": "vmess"
    },
    {
      "server": "127.0.0.1",
      "server_port": 41853,
      "tag": "golden-sel-xray",
      "type": "socks"
    },
    {
      "server": "127.0.0.1",
      "server_port": 40369,
      "tag": "golden-sel-anytls",
      "type": "socks"
    },
    {
      "password": "golden-pass-trojan",
      "server": "trojan.example.com",
      "server_port": 443,
      "tls": {
        "enabled": true,
        "insecure": false,
        "server_name": "trojan.example.com"
      },
      "tag": "golden-sel-trojan",
      "type": "trojan"
    },
    {
      "down_mbps": 0,
      "hop_interval": "10s",
      "password": "golden-pass-hy2",
      "server": "hy2.example.com",
      "server_ports": [
        "20000:20100"
      ],
      "tls": {
        "alpn": [
          "h3"
        ],
        "enabled": true,
        "insecure": false
      },
      "up_mbps": 0,
      "tag": "golden-sel-hy2",
      "type": "hysteria2"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "bypass",
      "type": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns-direct",
      "strategy": "prefer_ipv4"
    },
    "rule_set": [],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "port": [
          53
        ]
      },
      {
        "action": "hijack-dns",
        "protocol": [
          "dns"
        ]
      },
      {
        "inbound": [
          "c-2-mapping-2"
        ],
        "outbound": "direct"
      },
      {
        "inbound": [
          "c-3-mapping-3"
        ],
        "outbound": "direct"
      },
      {
        "action": "reject",
        "ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ]
      },
      {
        "action": "reject",
        "source_ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ]
      }
    ]
  }
}