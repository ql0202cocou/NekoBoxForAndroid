{
  "dns": {
    "final": "dns-remote",
    "rules": [
      {
        "domain": [
          "wg.example.com",
          "dns.example.net"
        ],
        "server": "dns-direct",
        "strategy": "ipv4_only"
      },
      {
        "disable_cache": true,
        "inbound": [
          "tun-in"
        ],
        "server": "dns-fake",
        "strategy": "ipv4_only"
      }
    ],
    "servers": [
      {
        "detour": "direct",
        "tag": "dns-local",
        "type": "local"
      },
      {
        "domain_resolver": "dns-local",
        "path": "/dns-query",
        "server": "192.0.2.53",
        "tag": "dns-direct",
        "type": "https"
      },
      {
        "detour": "proxy",
        "domain_resolver": "dns-direct",
        "path": "/dns-query",
        "server": "dns.example.net",
        "tag": "dns-remote",
        "type": "https"
      },
      {
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18",
        "tag": "dns-fake",
        "type": "fakeip"
      }
    ],
    "strategy": "ipv4_only"
  },
  "endpoints": [
    {
      "address": [
        "10.66.0.2/32",
        "fd00:66::2/128"
      ],
      "mtu": 1408,
      "peers": [
        {
          "address": "wg.example.com",
          "allowed_ips": [
            "0.0.0.0/0",
            "::/0"
          ],
          "persistent_keepalive_interval": 25,
          "port": 21820,
          "pre_shared_key": "Z29sZGVuLXdpcmVndWFyZC1wcmVzaGFyZWQtay0wMDE=",
          "public_key": "Z29sZGVuLXdpcmVndWFyZC1wZWVyLXB1YmtleS0wMDE=",
          "reserved": [
            1,
            2,
            3
          ]
        }
      ],
      "private_key": "Z29sZGVuLXdpcmVndWFyZC1wcml2YXRlLWtleS0wMDE=",
      "tag": "proxy",
      "type": "wireguard"
    }
  ],
  "inbounds": [
    {
      "address": [
        "172.19.0.1/28"
      ],
      "endpoint_independent_nat": true,
      "mtu": 9000,
      "stack": "gvisor",
      "tag": "tun-in",
      "type": "tun"
    },
    {
      "listen": "127.0.0.1",
      "listen_port": 2080,
      "tag": "mixed-in",
      "type": "mixed"
    }
  ],
  "log": {
    "level": "panic"
  },
  "outbounds": [
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "bypass",
      "type": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns-direct",
      "strategy": "prefer_ipv4"
    },
    "rule_set": [],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "port": [
          53
        ]
      },
      {
        "action": "hijack-dns",
        "protocol": [
          "dns"
        ]
      },
      {
        "action": "reject",
        "ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ]
      },
      {
        "action": "reject",
        "source_ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ]
      }
    ]
  }
}