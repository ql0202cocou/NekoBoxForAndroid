        "tag": "neko-trial"
      },
      "category": "TLS_CERTIFICATE",
      "note": "主节点的 Trojan 自定义证书读不出来"
    },
    {
      "scenario": "bug001-main-bad-wireguard",
      "server": "bug001-main-wg.example.com",
      "kind": "endpoint",
