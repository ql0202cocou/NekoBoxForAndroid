    },
    {
      "scenario": "bug001-front-proxy-bad",
      "server": "bug001-front-bad.example.com",
      "kind": "outbound",
      "json": {
        "server": "bug001-front-bad.example.com",
        "server_port": 8388,
        "method": "2022-blake3-aes-128-gcm",
        "password": "golden*ss2022*not*base64",
        "type": "shadowsocks",
        "tag": "neko-trial"
      },
      "category": "SS_KEY_BASE64",
      "note": "分组前置节点是 2022-blake3-aes-128-gcm、密钥含 '*'，不是 base64"
