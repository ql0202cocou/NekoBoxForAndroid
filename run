#!/bin/bash

EXEC=""
TARGET="buildScript"
ORIG_ARGS="$*"
declare -a PARAMS

for e in "$@"; do
  if [ -n "$EXEC" ]; then
    # first match wins; remaining args are passed to the matched script
    PARAMS+=("$e")
    continue
  fi
  # 脚本名段只接受 [A-Za-z0-9_-]+，拒绝空串、/、..，防止拼出 buildScript/ 之外的路径
  if [[ ! "$e" =~ ^[A-Za-z0-9_-]+$ ]]; then
    echo "invalid script name segment: '$e'" >&2
    exit 1
  fi
  TARGET="$TARGET/$e"
  PARAMS+=("$e")
  if [ -f "${TARGET}.sh" ] && [ -x "${TARGET}.sh" ]; then
    EXEC="${TARGET}.sh"
    PARAMS=()
  fi
done

if [ -z "$EXEC" ]; then
  echo "no matching build script for: $ORIG_ARGS" >&2
  exit 1
fi

echo ">> $EXEC"
exec "$EXEC" "${PARAMS[@]}"
